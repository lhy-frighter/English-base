        }
      ]
    },
    {
      "i": 1,
      "synthMs": 6150,
      "audioMs": 7.91,
      "chunks": [
        {
          "text": "Attention mechanisms,",
          "synthMs": 1647,
          "audioMs": 2.02
        },
        {
          "text": "unlike recurrent networks,",
          "synthMs": 1729,
          "audioMs": 2.13
        },
        {
          "text": "allow parallel computation across tokens.",
          "synthMs": 2774,
          "audioMs": 3.38
        }
      ]
    },
    {
      "i": 2,
      "synthMs": 5261,
      "audioMs": 6.4,
      "chunks": [
        {
          "text": "The transformer architecture relies on multi-head self-attention and positional encodings.",
          "synthMs": 5261,
          "audioMs": 6.4
        }
      ]
    },
    {
      "i": 3,
      "synthMs": 6258,
      "audioMs": 8.13,
      "chunks": [
        {
          "text": "Gradient descent converges when the learning rate,",
          "synthMs": 2717,
          "audioMs": 3.35
        },
        {
          "text": "e.g. 0.001,",
          "synthMs": 2278,
          "audioMs": 2.83
        },
        {
          "text": "is small enough.",
          "synthMs": 1263,
          "audioMs": 1.57
        }
      ]
    },
    {
      "i": 4,
      "synthMs": 5673,
      "audioMs": 7.33,
      "chunks": [
        {
          "text": "Satoshi Nakamoto's identity remains unknown;",
          "synthMs": 2999,
          "audioMs": 3.65
        },
        {
          "text": "however,",
          "synthMs": 1107,
          "audioMs": 1.38
        },
        {
          "text": "the blockchain persists.",
          "synthMs": 1567,
          "audioMs": 1.93
        }
      ]
    },
    {
      "i": 5,
      "synthMs": 4626,
      "audioMs": 6.03,
      "chunks": [
        {
          "text": "The quokka,",
          "synthMs": 1320,
          "audioMs": 1.63
        },
        {
          "text": "a small marsupial,",
          "synthMs": 1465,
          "audioMs": 1.8
        },
        {
          "text": "lives on Rottnest Island.",
          "synthMs": 1840,
          "audioMs": 2.23
        }
      ]
    },
    {
      "i": 6,
      "synthMs": 4088,
      "audioMs": 5.1,
      "chunks": [
        {
          "text": "We propose a novel isomorphism between the two algebraic structures.",
          "synthMs": 4087,
          "audioMs": 5.1
        }
      ]
    },
    {
      "i": 7,
      "synthMs": 4507,
      "audioMs": 5.63,
      "chunks": [
        {
          "text": "Convolutional neural networks extract local features before global pooling.",
          "synthMs": 4507,
          "audioMs": 5.63
        }
      ]
    },
    {
      "i": 8,
      "synthMs": 6446,
      "audioMs": 8.14,
      "chunks": [
        {
          "text": "Mr. O'Brien invested $2,500.50 in March,",
          "synthMs": 4660,
          "audioMs": 5.72
        },
        {
          "text": "i.e. nearly everything he had.",
          "synthMs": 1786,
          "audioMs": 2.23
        }
      ]
    },
    {
      "i": 9,
      "synthMs": 6549,
      "audioMs": 8.35,
      "chunks": [
        {
          "text": "Entropy measures uncertainty;",
          "synthMs": 2060,
          "audioMs": 2.42
        },
        {
          "text": "cross-entropy,",
          "synthMs": 1391,
          "audioMs": 1.68
        },
        {
          "text": "by contrast,",
          "synthMs": 1372,
          "audioMs": 1.65
        },
        {
          "text": "compares distributions.",
          "synthMs": 1726,
          "audioMs": 2.02
        }
      ]
    },
    {
      "i": 10,
      "synthMs": 2946,
      "audioMs": 3.6,
      "chunks": [
        {
          "text": "The zorpalod quivered in the flibbertigibbet's garden.",
          "synthMs": 2946,
          "audioMs": 3.6
        }
      ]
    },
    {
      "i": 11,
      "synthMs": 4625,
      "audioMs": 6.31,
      "chunks": [
        {
          "text": "Wait —",
          "synthMs": 1002,
          "audioMs": 1.25
        },
        {
          "text": "you mean she actually finished the dissertation?",
          "synthMs": 2479,
          "audioMs": 2.95
        },
        {
          "text": "Really?",
          "synthMs": 1144,
          "audioMs": 1.4
        }
      ]
    },
    {
      "i": 12,
      "synthMs": 4459,
      "audioMs": 5.69,
      "chunks": [
        {
          "text": "Backpropagation computes gradients via the chain rule,",
