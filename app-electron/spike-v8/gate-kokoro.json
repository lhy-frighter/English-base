      "audioMs": 8.69,
      "chunks": [
        {
          "text": "Dr. Smith published 3.14 pages in the U.S. in 2024,",
          "synthMs": 4880,
          "audioMs": 6.05
        },
        {
          "text": "earning 1,000 citations.",
          "synthMs": 2011,
